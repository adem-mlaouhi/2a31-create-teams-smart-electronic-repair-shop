      <property name="styleSheet">
       <string notr="true">QWidget#sideFormContainer {
    background-color: #ffffff;
}
/* Slight visual separation from sidebar */
QWidget#sideFormContainer QWidget#formPanel {
    background-color: #fbf7ff;
    border: 1px solid #f0e7f6;
    border-radius: 8px;
    margin: 12px;
    padding: 16px;
}
QWidget#sideFormContainer QLabel#nameLabel, 
QWidget#sideFormContainer QLabel#emailLabel,
QWidget#sideFormContainer QLabel#subjectLabel,
QWidget#sideFormContainer QLabel#messageLabel {
    color: #2c3e50;
    font-weight: 600;
    margin-bottom: 6px;
}
QWidget#sideFormContainer QLineEdit#nameLineEdit, 
QWidget#sideFormContainer QLineEdit#emailLineEdit,
QWidget#sideFormContainer QLineEdit#subjectLineEdit,
QWidget#sideFormContainer QTextEdit#messageTextEdit {
    border: 1px solid #e6dff0;
    border-radius: 6px;
    padding: 8px 10px;
    background: white;
}
QWidget#sideFormContainer QLineEdit#nameLineEdit:focus, 
QWidget#sideFormContainer QLineEdit#emailLineEdit:focus,
QWidget#sideFormContainer QLineEdit#subjectLineEdit:focus,
QWidget#sideFormContainer QTextEdit#messageTextEdit:focus {
    border-color: #6A1B9A;
}
QWidget#sideFormContainer QPushButton#contactSubmitBtn {
    background-color: #6A1B9A;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 10px 16px;
    font-weight: bold;
}
QWidget#sideFormContainer QPushButton#contactSubmitBtn:pressed {
    background-color: #4a0072;
}
</string>
