  <property name="styleSheet">
   <string notr="true">QMainWindow {
    background-color: #ffffff;
    font-family: 'Times New Roman', serif;
}

/* Remove all hover effects and animations */
QLabel {
    color: #2c3e50;
    font-family: 'Times New Roman', serif;
    font-size: 14px;
    font-weight: 600;
}

/* Sidebar button styling - rounded with gradient effect */
QPushButton {
    text-align: left;
    padding: 12px 24px;
    border: 1px solid #dee2e6;
    background-color: #f8f9fa;
    color: #2c3e50;
    font-family: 'Times New Roman', serif;
    font-size: 14px;
    font-weight: 600;
    border-radius: 8px;
    margin: 2px;
}

QPushButton[checked=&quot;true&quot;] {
    background-color: #f3e6fb;
    color: #6A1B9A;
    border: 2px solid #6A1B9A;
    font-weight: bold;
    border-radius: 8px;
}

QPushButton:pressed {
    background-color: #e9ecef;
}

/* Tab Widget styling without animations */
QTabWidget::pane {
    border: 1px solid #e1e8ed;
    border-radius: 8px;
    background-color: #ffffff;
    margin-top: 4px;
}

QTabWidget::tab-bar {
    alignment: left;
    left: 8px;
}

QTabBar::tab {
    background-color: #f8f9fa;
    border: 1px solid #dee2e6;
    border-bottom: none;
    border-radius: 6px 6px 0 0;
    padding: 12px 24px;
    margin-right: 2px;
    font-weight: 600;
    color: #657786;
    font-family: 'Times New Roman', serif;
    font-size: 14px;
    min-width: 80px;
}

QTabBar::tab:selected {
    background-color: #ffffff;
    color: #6A1B9A;
    border-bottom: 3px solid #6A1B9A;
    font-weight: bold;
}

/* Table styling */
QTableWidget {
    border: 1px solid #bdc3c7;
    background-color: #ffffff;
    font-family: 'Times New Roman', serif;
    font-size: 12px;
    gridline-color: #ecf0f1;
    selection-background-color: #6A1B9A;
    selection-color: white;
}

QHeaderView::section {
    background-color: #ecf0f1;
    padding: 8px;
    border: 1px solid #bdc3c7;
    font-weight: bold;
    font-size: 12px;
    color: #2c3e50;
    font-family: 'Times New Roman', serif;
}

/* Input styling */
QLineEdit {
    border: 2px solid #dee2e6;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 14px;
    background-color: white;
    color: #495057;
    font-family: 'Times New Roman', serif;
}

QLineEdit:focus {
    border-color: #6A1B9A;
}

/* Action buttons */
QPushButton#loginBtn, QPushButton#changePhotoBtn, QPushButton#removePhotoBtn, QPushButton#backToMainButton {
    background-color: #6A1B9A;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 8px 16px;
    font-family: 'Times New Roman', serif;
    font-weight: bold;
}

/* Employer module buttons - Rectangle sharp style */
QPushButton#searchButton, QPushButton#sortByIdButton, QPushButton#exportPdfButton {
    background-color: #6A1B9A;
    color: white;
    border: none;
    border-radius: 0px;
    padding: 10px 20px;
    font-family: 'Times New Roman', serif;
    font-weight: bold;
    font-size: 13px;
    min-height: 32px;
}

QPushButton#searchButton:pressed, QPushButton#sortByIdButton:pressed, QPushButton#exportPdfButton:pressed {
    background-color: #2a0033;
}

/* Employer action buttons - Purple rectangle sharp style with spacing */
QPushButton#saveEmployeeButton, QPushButton#editSelectedButton, QPushButton#deleteSelectedButton {
    background-color: #8e44ad;
    color: white;
    border: none;
    border-radius: 0px;
    padding: 10px 20px;
    margin: 8px;
    font-family: 'Times New Roman', serif;
    font-weight: bold;
    font-size: 13px;
    min-height: 32px;
}

QPushButton#saveEmployeeButton:pressed, QPushButton#editSelectedButton:pressed, QPushButton#deleteSelectedButton:pressed {
    background-color: #4a0072;
}

QPushButton#removePhotoBtn {
    background-color: #dc3545;
}
</string>
